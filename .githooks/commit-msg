#!/usr/bin/env bash
# Rejette les commits qui ne suivent pas Conventional Commits
# (https://www.conventionalcommits.org/fr/).
# Activé via `git config core.hooksPath .githooks` (une fois, cf.
# docs/technical/00-setup-environnement.md).

commit_msg_file="$1"
first_line=$(head -n1 "$commit_msg_file")

# Laisse passer les commits de merge sans validation.
if [[ "$first_line" =~ ^Merge ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./_-]+\))?!?: .{1,100}$'

if [[ ! "$first_line" =~ $pattern ]]; then
  echo "❌ Message de commit invalide : \"$first_line\""
  echo ""
  echo "Format attendu (Conventional Commits) :"
  echo "  <type>(<scope optionnel>): <description>"
  echo ""
  echo "Types valides : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "Exemples :"
  echo "  feat: ajouter le formulaire de profil animal"
  echo "  fix(rappels): corriger le calcul de la prochaine échéance"
  echo "  chore(deps): monter riverpod en 2.x"
  exit 1
fi

exit 0